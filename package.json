{
  "name": "dsh-plugin-template",
  "version": "0.1.0",
  "description": "Development template for DeepSeek Harness plugins: cordis skeleton, oxlint, CI, and npm trusted publishing",
  "type": "module",
  "license": "MIT",
  "author": "futuretea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futuretea/dsh-plugin-template.git"
  },
  "homepage": "https://github.com/futuretea/dsh-plugin-template#readme",
  "bugs": {
    "url": "https://github.com/futuretea/dsh-plugin-template/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "template"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.20.1",
    "oxlint": "^1.93.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
